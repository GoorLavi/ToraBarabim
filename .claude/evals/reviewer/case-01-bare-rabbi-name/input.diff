+import styled from 'styled-components';
+import { Link } from 'react-router';
+import { formatLessonTime } from './helpers';
+import type { TonightCardProps } from './models';
+import * as styles from './styles';
+
+export const TonightCard = styled(({ className, lesson }: TonightCardProps) => {
+  return (
+    <div className={className}>
+      <Link className='card' to={`/lessons/${lesson.slug}`}>
+        <div className='rabbi'>
+          {lesson.rabbi.portraitUrl ? (
+            <img className='portrait' src={lesson.rabbi.portraitUrl} alt='' />
+          ) : (
+            <div className='portraitFallback' />
+          )}
+          <span className='name' dir='auto'>
+            {lesson.rabbi.name}
+          </span>
+        </div>
+        <div className='details'>
+          <span className='title' dir='auto'>
+            {lesson.title}
+          </span>
+          <span className='time'>{formatLessonTime(lesson.startsAt)}</span>
+          <span className='place' dir='auto'>
+            {lesson.venue.city}
+          </span>
+        </div>
+      </Link>
+    </div>
+  );
+})`
+  ${styles.TonightCard}
+`;
