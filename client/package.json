{
  "name": "client",
  "private": true,
  "version": "0.1.0",
  "description": "Hebrew, right-to-left web client for the ToraBarabim lesson search",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env ../node_modules/.bin/vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@torabarabim/common": "*",
    "classnames": "^2.5.1",
    "mixpanel-browser": "^2.83.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "styled-components": "^6.5.2"
  },
  "devDependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@react-router/dev": "^7.18.2",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.56.0",
    "storybook": "^10.5.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
