{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    // Vite's coming `configLoader: 'native'` resolves vite.config.ts without
    // a bundler, so its imports need real file extensions. Safe to allow
    // because this project only type checks: `noEmit` is on below.
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "react-router.config.ts", ".storybook"]
}
