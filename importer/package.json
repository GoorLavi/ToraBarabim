{
  "name": "importer",
  "private": true,
  "version": "0.1.0",
  "description": "CLI that hands a collected weekly rows file to the server's agent import routes",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx --env-file=../.env src/index.ts",
