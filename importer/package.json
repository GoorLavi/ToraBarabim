    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@torabarabim/common": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
