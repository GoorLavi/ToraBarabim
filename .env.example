# Server
PORT=
HOST=

# Comma-separated list of origins allowed to call the API (e.g. the Vite dev origin)
CORS_ORIGINS=

# Logging level for Pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=

# Postgres (docker-compose.dev.yml reads these three to start the dev database)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# The app's own connection string. Host port is 5433 (see docker-compose.dev.yml),
# not Postgres's default 5432; keep the user/password/db in sync with the three above.
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5433/<POSTGRES_DB>
DATABASE_URL=

# Scraper (also reads DATABASE_URL above, read-only, to resolve city names).
# All optional; each has a sane default in scraper/src/config.ts.
SCRAPER_USER_AGENT=
SCRAPER_REQUEST_DELAY_MS=
SCRAPER_REQUEST_TIMEOUT_MS=
SCRAPER_RETRY_COUNT=
SCRAPER_RETRY_BASE_DELAY_MS=
SCRAPER_CACHE_TTL_MS=
SCRAPER_CACHE_DIR=
SCRAPER_OUTPUT_DIR=

# Used by the ayal-taarog adapter to read its weekly schedule poster image.
ANTHROPIC_API_KEY=

# Admin sessions
# Secret used to sign the admin session cookie. Minimum 32 characters.
SESSION_SECRET=
# How long an admin session stays valid, in hours. Defaults to 168 (a week).
SESSION_TTL_HOURS=

# admin:create script only, never read by the running server. Set to exactly
# 'true' to allow a password as short as 6 characters (local dev only).
ALLOW_WEAK_ADMIN_PASSWORD=

# Object storage (admin photo uploads). Locally this points at the MinIO
# container in docker-compose.dev.yml; in production leave STORAGE_ENDPOINT
# empty so the AWS SDK talks to real S3.
# http://localhost:9000 locally, empty in production (real AWS S3)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# The base URL the browser fetches uploaded images from
# e.g. http://localhost:9000/<bucket> locally, or a CDN URL in production
STORAGE_PUBLIC_BASE_URL=
# Maximum size in bytes for a single upload. Defaults to 5,000,000 (5 MB).
MAX_UPLOAD_BYTES=
