**/node_modules
**/.git
.env
.env.*
!.env.example

# The Dockerfile builds the client itself (`npm run build -w client` in the
# `build` stage) rather than expecting a pre-built one from the host, so a
# stale `client/build` left over from a local build must stay out of the
# context: copying it in would let it silently override the fresh one the
# image generates.
client/build
client/.vite
scraper/dist
scraper/.cache
scraper/output
infra/dist
infra/cdk.out
server/dist

**/*.log
**/.DS_Store
