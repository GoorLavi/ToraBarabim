{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "description": "REST API serving the ToraBarabim lesson search",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "node --env-file=../.env ../node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=../.env ../node_modules/.bin/drizzle-kit migrate",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts",
    "admin:create": "tsx --env-file=../.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@torabarabim/common": "*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nanoid": "^5.1.16",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-zod": "^0.8.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
