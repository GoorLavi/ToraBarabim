{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "description": "REST API serving the ToraBarabim lesson search",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --env-file=../.env --test --test-concurrency=1 test/public-api.test.ts test/ssr.test.ts test/agent-import.test.ts test/rabbi-order.test.ts test/admin-api.test.ts test/panel-auth.test.ts test/place-api.test.ts test/invariants.test.ts test/dedication-text.test.ts test/dedication-band.test.ts",
    "db:generate": "node --env-file=../.env ../node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=../.env ../node_modules/.bin/drizzle-kit migrate",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts",
    "db:seed:no-photos": "tsx --env-file=../.env src/db/seed.ts --skip-portraits",
    "db:seed:cities-only": "tsx --env-file=../.env src/db/seed-cities-only.ts",
    "admin:promote-super": "tsx --env-file=../.env src/scripts/promote-super-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@torabarabim/common": "*",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nanoid": "^5.1.16",
    "postgres": "^3.4.9",
    "react-router": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
