{
  "name": "infra",
  "private": true,
  "version": "0.1.0",
  "description": "AWS CDK app defining the ToraBarabim network, database, and API server",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.265.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.1110.0",
    "@types/node": "^26.2.0",
    "aws-cdk": "^2.1136.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
